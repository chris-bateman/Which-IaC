{
  "mustHave": [
    {
      "id": "mh-cloudformation",
      "questionId": "cloudformation_required",
      "match": { "equals": "yes" },
      "excludes": [
        "pulumi",
        "terraform",
        "opentofu",
        "formae",
        "ansible",
        "puppet",
        "chef",
        "crossplane"
      ],
      "reason": "Requires AWS CloudFormation as the deployment engine."
    },
    {
      "id": "mh-no-state-files",
      "questionId": "no_state_files",
      "match": { "equals": "yes" },
      "excludes": ["pulumi", "terraform", "opentofu"],
      "reason": "Requires a tool that does not use separate state files."
    }
  ],
